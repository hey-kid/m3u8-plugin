{
  "name": "m3u8-catcher",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "description": "Automatically discover and copy HLS playlist URLs in Microsoft Edge.",
  "scripts": {
    "dev": "vite build --watch",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "test": "vitest run",
    "verify": "npm run build && node scripts/verify-extension.mjs && node scripts/verify-history.mjs && node scripts/verify-status.mjs",
    "verify:history": "npm run build && node scripts/verify-history.mjs",
    "verify:status": "npm run build && node scripts/verify-status.mjs"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
